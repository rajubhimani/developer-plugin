# Copy to .env for local work:  cp .env.example .env
# .env is git-ignored and docker-ignored. This file lists every setting, with
# safe dummy values only. Never put a real credential here.
#
# The same names are used by the Settings class, Compose and the Kubernetes
# ConfigMap (plain values) and Secret (credentials).

# ---- plain settings (ConfigMap in Kubernetes) -------------------------------
APP_ENV=local
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=console
APP_REQUEST_TIMEOUT_SECONDS=10

# ---- Compose only: image tags and local credentials -------------------------
DB_IMAGE=<postgres-image:tag>
DB_PASSWORD=local-only-change-me
ADMINER_IMAGE=<adminer-image:tag>

# ---- secrets (Secret in Kubernetes, synced from a secrets manager) ----------
# Local dummies. In a cluster these come from the platform, never from a file.
APP_DATABASE_URL=postgresql://app:local-only-change-me@localhost:5432/app
APP_API_KEY=dummy-key-for-local-use
