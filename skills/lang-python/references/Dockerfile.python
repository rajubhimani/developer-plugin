# syntax=docker/dockerfile:1
# Multi-stage image for a Python app managed with uv (src layout).
# Replace every placeholder written in angle brackets. Pin both images by digest for release builds
# (see the docker skill); keep the readable tag in a comment beside the digest.
#
#   docker build --target runtime -t app:local .
#   docker build --target dev     -t app:dev   .   # used by compose
ARG PYTHON_IMAGE=<python-slim-image:tag@sha256:digest>
ARG UV_IMAGE=<uv-image:tag@sha256:digest>

# Source of the uv binary, so the version is pinned like any other image.
FROM ${UV_IMAGE} AS uv

# ---- base: shared by builder and runtime so paths and platform match --------
FROM ${PYTHON_IMAGE} AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

# ---- builder: creates the virtual environment ------------------------------
FROM base AS builder
COPY --from=uv /uv /uvx /bin/
# Compile bytecode now for fast start-up; copy (not link) files out of the cache
# mount; never download an interpreter, use the one in the base image.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
# If a dependency builds from source, install the compilers and headers HERE only.

# 1) Dependencies only. Reads the lock and project files by bind mount, so this
#    layer changes only when they change. The cache mount keeps downloads between
#    builds and is not stored in the image.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-dev

# 2) Your code. Changes every commit, so it comes last.
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

# ---- dev: for Compose, adds dev tools and uses the source from a watch sync -
FROM builder AS dev
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "--factory", "<package>.main:create_app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ---- runtime: what ships ----------------------------------------------------
FROM base AS runtime
ARG REVISION=unknown
LABEL org.opencontainers.image.revision=$REVISION
# Non-root, numeric id so Kubernetes can verify it.
RUN groupadd --system --gid 10001 app \
 && useradd  --system --uid 10001 --gid app --no-create-home app
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
USER 10001:10001
EXPOSE 8000
# Exec form: the server is process 1 and receives SIGTERM directly.
# One server process per container; scale with replicas.
CMD ["uvicorn", "--factory", "<package>.main:create_app", "--host", "0.0.0.0", "--port", "8000"]
