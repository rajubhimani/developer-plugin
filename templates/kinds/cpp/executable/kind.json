{
  "title": "Executable",
  "summary": "A program with its logic in a library, so it can be tested.",
  "use_when": "The product is a command or service; keep main thin.",
  "standalone": true,
  "required": [
    "CMakeLists.txt",
    "CMakePresets.json",
    "src/main.cpp",
    "src/{{package}}.cpp",
    "src/{{package}}.hpp",
    "tests/test_{{package}}.cpp",
    "README.md"
  ],
  "adopt_safe": [
    ".clang-format",
    ".clang-tidy"
  ],
  "skip_common": [
    "compose.yaml"
  ],
  "makefile": "cpp-cmake.mk"
}
